# Raw captures can contain nearby devices' identifiers and personal body data.
# Curated, reviewed fixtures belong in research/tests/fixtures instead.
captures/*
!captures/.gitkeep

.venv/
__pycache__/
*.egg-info/
.pytest_cache/
*.json.tmp
.DS_Store

.env
.env.*
!.env.example
.secrets/

# Local app database and raw source archive contain personal health data.
data/

# Working notes that may reference real account numbers/history; never meant to be shared.
notes/
node_modules/
dist/
*.tsbuildinfo
