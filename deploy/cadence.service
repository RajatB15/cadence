[Unit]
Description=Cadence backend
After=network-online.target
Wants=network-online.target

[Service]
User=cadence
Group=cadence
WorkingDirectory=/opt/cadence/app/backend
EnvironmentFile=/etc/cadence/cadence.env
ExecStart=/opt/cadence/app/backend/.venv/bin/python -m cadence_app.server
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# The service only needs its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cadence
ProtectKernelTunables=true
RestrictSUIDSGID=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
PrivateDevices=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Cap memory so a runaway OCR or rebuild is killed instead of taking the droplet down (raise on larger machines).
# When the cap is hit the kernel OOM-kills the service (systemd restarts it); check for it with:
#   journalctl -k | grep -i "out of memory"; journalctl -u cadence | grep -i "oom-kill\|memory"
# and systemctl show cadence -p NRestarts -p MemoryPeak. Raise MemoryMax if it recurs.
MemoryMax=900M
MemoryHigh=750M

[Install]
WantedBy=multi-user.target
