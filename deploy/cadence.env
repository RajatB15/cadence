CADENCE_DATA_DIR=/var/lib/cadence/data
CADENCE_SECRETS_FILE=/etc/cadence/garmin.env
CADENCE_WEB_DIST=/opt/cadence/app/web/dist
# Phone share server bind address. Default 0.0.0.0 (LAN). enable-public.sh sets 127.0.0.1 so only Caddy reaches it, and CADENCE_PUBLIC_URL (the https address the pairing QR uses).
# CADENCE_SHARE_HOST=127.0.0.1
# CADENCE_PUBLIC_URL=https://cadence.<ip-with-dashes>.sslip.io
